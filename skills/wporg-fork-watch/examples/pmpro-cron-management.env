# wporg-fork-watch config: one file per watched plugin, sourced by bash.
# Install as ~/.config/wporg-fork-watch/pmpro-cron-management.env

SLUG="wp-crontrol"                                   # WordPress.org plugin slug (plugins.svn.wordpress.org/<slug>)
UPSTREAM_NAME="WP Crontrol"                          # human name used in commits, PR titles, and messages
REPO="$HOME/repos/strangerstudios/pmpro-cron-management"    # local checkout of the fork
BASE_BRANCH="main"                                   # branch the PR targets
VENDOR_BRANCH="wp-crontrol"                          # pristine SVN exports, one commit per release
TAG_PREFIX="wp-crontrol-"                            # git tag per imported release: wp-crontrol-2.0.0
PR_BRANCH_PREFIX="flint/upstream-"                   # PR head branch: flint/upstream-2.0.1
PR_LABEL="upstream-sync"
PUSH_REMOTE="origin"                                 # where branches and tags are pushed
# BASE_REMOTE="upstream"                             # defaults to "upstream" when that remote exists (fork model), else PUSH_REMOTE
# PR_REPO="strangerstudios/pmpro-cron-management"           # defaults to BASE_REMOTE's GitHub slug

POLICY_FILE="$HOME/skills/wporg-fork-watch/examples/pmpro-cron-management.policy.md"

# Agent that finishes the merge. Reads the prompt on stdin, runs inside the worktree.
# Default (leave unset): claude -p, opus, high effort, edits auto-accepted, shell limited to
# git/php/grep/ls/find/cat/diff/head/tail/wc/sed. Override AGENT_TOOLS to widen or narrow that,
# or AGENT_CMD to use another harness (codex exec, pi, ...).
# AGENT_TOOLS="Read,Edit,Write,Glob,Grep,Bash(git:*),Bash(php:*)"
AGENT_TIMEOUT=3600

# Review: "builtin" runs REVIEW_AGENT_CMD over the PR diff and posts a GitHub review;
# or any command that takes the PR URL as its first argument; or "none".
REVIEW_CMD="builtin"
REVIEW_AGENT_CMD="claude -p --model opus --effort medium"

# Lint gate after the agent: "builtin" = php -l on changed PHP files; or a command run in the worktree; or "none".
LINT_CMD="builtin"

# Notify: a command that reads the message on stdin ($PR_URL, $VERSION, $SLUG, $PR_REPO are exported),
# and/or a Slack incoming webhook. With neither set, the message prints to stdout.
NOTIFY_CMD='cat'
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Cron schedule used by setup.sh --cron
SCHEDULE="30 6 * * *"
